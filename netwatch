    print(color(BOLD, f"  Historical Events (last {days}d, showing {len(events)}/{total})"))
    print(color(D, f"  {'TIME':20s}  {'TYPE':8s}  {'DEVICE':16s}  {'SERVICE':10s}  HOST"))
    print(color(D, "  " + "─" * 90))

    for e in reversed(events):
        t = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(e["ts"]))
        kind_str = e.get("kind", "?")
        kind_color = {"tls": G, "dns": C, "mdns": M, "http": Y}.get(kind_str, D)
        dev_str = e.get("dev", "?")
        host_str = e.get("host", "")
        svc_str = e.get("service", "") or ""
        print(f"  {color(D, t):20s}  {color(kind_color, kind_str.upper()):8s}  {dev_str:16s}  {svc_str:10s}  {color(B, host_str[:50])}")

    print()

