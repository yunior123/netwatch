def main():
    parser = argparse.ArgumentParser(prog="netwatch", description="netwatch CLI", add_help=False)
    parser.add_argument("command", nargs="?", default="help")
    parser.add_argument("ip", nargs="?", default=None)
    parser.add_argument("--no-banner", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("-n", "--lines", type=int, default=30)
    parser.add_argument("-d", "--days", type=int, default=1)
    parser.add_argument("-l", "--limit", type=int, default=50)
    parser.add_argument("--device", type=str, default=None)
    parser.add_argument("--host", type=str, default=None)
    parser.add_argument("--kind", type=str, default=None)
    parser.add_argument("--service", type=str, default=None)
    parser.add_argument("query", nargs="?", default=None)
