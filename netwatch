def cmd_kill(args):
    """Kill a device's internet."""
    mini_banner()
    ip = args.ip
    if not ip:
        print(err("Usage: netwatch kill <ip>"))
        return
    # Resolve hostname to IP if needed
    devs = load_devices()
    if devs:
        for dip, dev in devs.get("devices", {}).items():
            if dev.get("hostname", "").lower() == ip.lower() or get_device_name(dev).lower() == ip.lower():
                ip = dip
                break
    print(info(f"Killing device {ip}..."))
    kill_file = DATA / "kill_list.json"
    DATA.mkdir(exist_ok=True)
    try:
        kill_list = json.loads(kill_file.read_text()) if kill_file.exists() else []
    except:
        kill_list = []
    if ip not in kill_list:
        kill_list.append(ip)
        kill_file.write_text(json.dumps(kill_list))
        print(ok(f"Device {ip} blocked"))
    else:
        print(warn(f"Device {ip} already blocked"))

def cmd_rescue(args):
    """Restore a killed device."""
    mini_banner()
    ip = args.ip
    if not ip:
        print(err("Usage: netwatch rescue <ip>"))
        return
    devs = load_devices()
    if devs:
        for dip, dev in devs.get("devices", {}).items():
            if dev.get("hostname", "").lower() == ip.lower() or get_device_name(dev).lower() == ip.lower():
                ip = dip
                break
    print(info(f"Rescuing device {ip}..."))
    kill_file = DATA / "kill_list.json"
    try:
        kill_list = json.loads(kill_file.read_text()) if kill_file.exists() else []
    except:
        kill_list = []
    if ip in kill_list:
        kill_list.remove(ip)
        kill_file.write_text(json.dumps(kill_list))
        print(ok(f"Device {ip} unblocked"))
    else:
        print(warn(f"Device {ip} not blocked"))

def cmd_install(args):
    target = Path("/usr/local/bin/netwatch")
    script = ROOT / "netwatch"
    print(info(f"Installing {script} → {target}"))
    try:
        result = subprocess.run(["osascript", "-e",
            f'do shell script "ln -sf {script} {target} && chmod +x {script}" with administrator privileges'
        ], capture_output=True, text=True)
        if result.returncode == 0:
            print(ok(f"Installed. Run from anywhere: netwatch"))
        else:
            print(err("Install failed"))
    except Exception as e:
        print(err(f"{e}"))

def cmd_uninstall(args):
    target = Path("/usr/local/bin/netwatch")
    try:
        subprocess.run(["osascript", "-e",
            f'do shell script "rm -f {target}" with administrator privileges'
        ], check=False)
        print(ok("Uninstalled"))
    except: pass

