#!/usr/bin/env python3
"""netwatch — CLI for the netwatch network monitor.

See `netwatch help` for commands.
"""
import sys, os, time, json, argparse, subprocess, signal, shutil
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
DATA = ROOT / "data"
STATE = DATA / "state.json"
DEVICES = DATA / "devices.json"
DB_PATH = DATA / "netwatch.db"
ARPSPOOF = ROOT / "arpspoof.py"
START_SCRIPT = Path("/tmp/start-arpspoof.sh")
LOG = Path("/tmp/netwatch-arpspoof.log")
LOG_PANEL = Path("/tmp/netwatch-next.log")
PANEL_DIR = ROOT / "panel"
PANEL_URL = "http://localhost:3000"

# ANSI colors
R, G, Y, B, C, M, W, D = "\033[91m", "\033[92m", "\033[93m", "\033[94m", "\033[96m", "\033[95m", "\033[97m", "\033[2m"
BOLD = "\033[1m"; RESET = "\033[0m"; DIM = "\033[2m"
UNDERLINE = "\033[4m"

def color(c, s):
    if sys.stdout.isatty():
        return f"{c}{s}{RESET}"
    return str(s)

def ok(s): return color(G + BOLD, f"✓ {s}")
def warn(s): return color(Y + BOLD, f"⚠ {s}")
def err(s): return color(R + BOLD, f"✗ {s}")
def info(s): return color(B, f"ℹ {s}")

def banner():
    print(color(C + BOLD, r"""
    _   __     __  _____           __
   / | / /__  / /_/ ___/__  ______/ /__  _____
  /  |/ / _ \/ __/\__ \/ / / / __  / _ \/ ___/
 / /|  /  __/ /_ ___/ / /_/ / /_/ /  __/ /
/_/ |_/\___/\__//____/\__,_/\__,_/\___/_/
"""))
    print(color(D, "  Real-time network monitor with ARP MITM + TLS interception"))
    print(color(D, "  https://github.com/yunior123/netwatch\n"))

def mini_banner():
    print(color(C + BOLD, "  netwatch") + color(D, " — network monitor\n"))

# ─── Service management ─────────────────────────────────────────────
PIDFILE = DATA / "arpspoof.pid"
PLIST = Path.home() / "Library/LaunchAgents" / "com.netwatch.arpspoof.plist"

def is_running(name):
    r = subprocess.run(["pgrep", "-fl", name], capture_output=True, text=True)
    return bool(r.stdout.strip())

def kill_all_arpspoof():
    subprocess.run(["pkill", "-9", "-f", "arpspoof.py"], check=False, capture_output=True)
    subprocess.run(["sudo", "-n", "pkill", "-9", "-f", "arpspoof.py"], check=False, capture_output=True)
    for f in [PIDFILE, Path("/tmp/netwatch-arpspoof.lock")]:
        try: f.unlink()
        except: pass

def start_arpspoof():
    if is_running("arpspoof.py"):
        print(warn("Found existing arpspoof — restarting..."))
        kill_all_arpspoof()
        time.sleep(2)
    DATA.mkdir(exist_ok=True)
    try:
        LOG.write_text("")
    except PermissionError:
        subprocess.run(["rm", "-f", str(LOG)], check=False, capture_output=True)
        LOG.touch()
    START_SCRIPT.write_text(f"""#!/bin/bash
cd {ROOT}
/usr/bin/python3 -B {ARPSPOOF} >> {LOG} 2>&1
""")
    START_SCRIPT.chmod(0o755)
    print(info("Starting ARP MITM..."))
    try:
        subprocess.Popen(["sudo", "-n", str(START_SCRIPT)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(6)
        if is_running("arpspoof.py"):
            print(ok("ARP MITM started"))
            return True
        log_content = LOG.read_text() if LOG.exists() else ""
        if "NameError" in log_content or "Error" in log_content:
            print(err(f"arpspoof crashed — {log_content.strip().splitlines()[-1][:80]}"))
        else:
            print(err("ARP MITM failed — check /tmp/netwatch-arpspoof.log"))
        return False
    except Exception as e:
        print(err(f"Failed to start: {e}"))
        return False

def stop_arpspoof():
    if not is_running("arpspoof.py"):
        return
    print(info("Stopping ARP MITM..."))
    kill_all_arpspoof()
    time.sleep(2)
    if is_running("arpspoof.py"):
        kill_all_arpspoof()
        time.sleep(1)
    if is_running("arpspoof.py"):
        print(warn("Root process alive — run: sudo pkill -9 -f arpspoof"))
    else:
        print(ok("ARP MITM stopped"))

def start_panel():
    if is_running("next dev"):
        print(info(f"Panel already running at {PANEL_URL}"))
        return True
    print(info("Starting web panel..."))
    subprocess.Popen(["npx", "next", "dev", "-p", "3000"],
                     cwd=PANEL_DIR, stdout=open(LOG_PANEL, "a"), stderr=subprocess.STDOUT)
    time.sleep(5)
    if is_running("next dev"):
        print(ok(f"Panel started at {PANEL_URL}"))
        return True
    print(err(f"Panel failed — check {LOG_PANEL}"))
    return False

def stop_panel():
    if not is_running("next dev"):
        return
    print(info("Stopping panel..."))
    subprocess.run(["pkill", "-f", "next dev"], check=False)
    time.sleep(2)
    print(ok("Panel stopped"))

def load_state():
    try: return json.loads(STATE.read_text())
    except: return None

def load_devices():
    try: return json.loads(DEVICES.read_text())
    except: return None

def get_device_name(dev):
    """Get display name for a device."""
    dm = dev.get("device_model", "")
    if dm and dm != "Unknown Device":
        return dm
    h = dev.get("hostname", "")
    if h and h not in ("?", "") and ":" not in h:
        return h
    return dev.get("vendor", "") or dev.get("ip", "Unknown")

def get_device_icon(dev):
    """Get icon for a device."""
    di = dev.get("device_icon", "")
    if di and di != "📡":
        return di
    h = (dev.get("hostname", "")).lower()
    if "iphone" in h or "ipad" in h or "phone" in h: return "📱"
    if "macbook" in h or "mac" in h: return "💻"
    if "tv" in h or "roku" in h or "firestick" in h: return "📺"
    if "watch" in h: return "⌚"
    if "thermostat" in h: return "🌡️"
    if "camera" in h or "c120" in h: return "📷"
    if "router" in h or "gateway" in h or "mynetwork" in h: return "🌐"
    if "pixel" in h or "galaxy" in h or "s24" in h or "s25" in h: return "📱"
    return "📡"

# ─── Commands ───────────────────────────────────────────────────────
def cmd_start(args):
    banner()
    arpspoof_ok = start_arpspoof()
    panel_ok = start_panel()
    if arpspoof_ok and panel_ok:
        print()
        print(ok("netwatch is live"))
        print(info(f"  Panel:   {PANEL_URL}"))
        print(info(f"  Status:  netwatch status"))
        print(info(f"  Devices: netwatch devices"))
        print(info(f"  Stop:    netwatch stop"))

def cmd_stop(args):
    banner()
    stop_arpspoof()
    stop_panel()
    print()
    print(ok("netwatch stopped"))

def cmd_restart(args):
    banner()
    stop_arpspoof()
    stop_panel()
    time.sleep(1)
    arpspoof_ok = start_arpspoof()
    panel_ok = start_panel()
    if arpspoof_ok and panel_ok:
        print()
        print(ok("netwatch restarted"))

def cmd_open(args):
    """Open web panel in browser."""
    subprocess.run(["open", PANEL_URL])
    print(ok(f"Opened {PANEL_URL}"))

def cmd_close(args):
    """Close web panel."""
    stop_panel()

def cmd_status(args):
    banner()
    arpspoof = is_running("arpspoof.py")
    panel = is_running("next dev")

    print(color(BOLD, "  Services"))
    print(f"    ARP MITM:   {ok('running') if arpspoof else err('stopped')}")
    print(f"    Web Panel:  {ok('running') if panel else err('stopped')}")
    print()

    state = load_state()
    if state:
        age = time.time() - state.get("updated", 0)
        fresh = color(G, f"{age:.0f}s ago") if age < 10 else color(Y, f"{age:.0f}s ago") if age < 60 else color(R, f"{age:.0f}s ago")
        print(color(BOLD, "  Live State"))
        print(f"    Packets:    {color(C, state.get('packets', 0))}")
        print(f"    Domains:    {color(C, len(state.get('domains', {})))}")
        print(f"    Devices:    {color(C, len(state.get('devices', {})))}")
        print(f"    Updated:    {fresh}")
        print(f"    Interface:  {color(C, state.get('iface', '—'))}")
    else:
        print(warn("No state data — services not running or no traffic captured"))
    print()

    devs = load_devices()
    if devs and devs.get("devices"):
        print(color(BOLD, "  Devices"))
        for ip, dev in list(devs["devices"].items())[:10]:
            events = dev.get("traffic_events", 0)
            name = get_device_name(dev)
            icon = get_device_icon(dev)
            ev_color = G if events > 100 else Y if events > 0 else D
            print(f"    {icon} {name:25s}  {color(D, ip):20s}  {color(ev_color, str(events))} events")
    print()

def cmd_devices(args):
    """List devices with type/model detection."""
    mini_banner()
    devs = load_devices()
    if not devs or not devs.get("devices"):
        print(warn("No devices found — run `netwatch start` first"))
        return

    print(color(BOLD, f"  {'IP':16s}  {'':2s} {'DEVICE':28s}  {'VENDOR':15s}  {'EVENTS':>6s}  {'HOSTS':>5s}"))
    print(color(D, "  " + "─" * 85))

    for ip, dev in sorted(devs["devices"].items(), key=lambda x: -x[1].get("traffic_events", 0)):
        events = dev.get("traffic_events", 0)
        vendor = dev.get("vendor", "")
        icon = get_device_icon(dev)
        name = get_device_name(dev)
        n_hosts = len(dev.get("domains", {}))
        ev_color = G if events > 100 else Y if events > 10 else D
        h = dev.get("hostname", "")
        extra = ""
        if h and h != name.lower() and h not in ("?", ""):
            extra = color(D, f" ({h})")
        print(f"  {ip:16s}  {icon} {name:28s}{extra}  {vendor[:15]:15s}  {color(ev_color, str(events)):>6s}  {color(C, str(n_hosts)):>5s}")
    print()

def cmd_who(args):
    """Show detailed info for a specific device."""
    mini_banner()
    ip = args.ip
    if not ip:
        print(err("Usage: netwatch who <ip>"))
        return

    devs = load_devices()
    if not devs or ip not in devs.get("devices", {}):
        # Try to find by hostname
        if devs:
            for dip, dev in devs["devices"].items():
                if dev.get("hostname", "").lower() == ip.lower():
                    ip = dip
                    break
        if ip not in devs.get("devices", {}):
            print(err(f"Device {ip} not found"))
            return

    dev = devs["devices"][ip]
    icon = get_device_icon(dev)
    name = get_device_name(dev)

    print(f"  {icon} {color(BOLD, name)}")
    print(f"  {'─' * 50}")
    print(f"  {'IP:':15s} {ip}")
    print(f"  {'MAC:':15s} {dev.get('mac', '—')}")
    print(f"  {'Vendor:':15s} {dev.get('vendor', '—')}")
    print(f"  {'Hostname:':15s} {dev.get('hostname', '—')}")
    print(f"  {'Type:':15s} {dev.get('device_type', '—')}")
    print(f"  {'Model:':15s} {dev.get('device_model', '—')}")
    print(f"  {'First seen:':15s} {time.strftime('%H:%M:%S', time.localtime(dev.get('first_seen', 0)))}")
    print(f"  {'Last seen:':15s} {time.strftime('%H:%M:%S', time.localtime(dev.get('last_seen', 0)))}")
    print(f"  {'Events:':15s} {dev.get('traffic_events', 0)}")
    print()

    # Services
    services = dev.get("services", {})
    if services:
        print(color(BOLD, "  Services"))
        for svc, cnt in sorted(services.items(), key=lambda x: -x[1]):
            print(f"    {cnt:>4}  {svc}")
        print()

    # Top domains
    domains = dev.get("domains", {})
    if domains:
        print(color(BOLD, "  Top Domains"))
        for dom, cnt in sorted(domains.items(), key=lambda x: -x[1])[:10]:
            print(f"    {cnt:>4}  {color(B, dom)}")
        print()

    # URLs
    urls = dev.get("urls", [])
    if urls:
        print(color(BOLD, "  Recent URLs"))
        for u in urls[-5:]:
            t = time.strftime("%H:%M:%S", time.localtime(u.get("t", 0)))
            svc = u.get("service", "")
            svc_icon = ""
            if svc:
                from device_detect import _icon_for
                svc_icon = ""
            print(f"    {color(D, t)}  {color(C, u.get('url', '')[:60])}")
        print()

def cmd_services(args):
    """Show detected services across all devices."""
    mini_banner()
    devs = load_devices()
    if not devs or not devs.get("devices"):
        print(warn("No devices found"))
        return

    # Aggregate services
    all_services = {}
    for ip, dev in devs["devices"].items():
        for svc, cnt in dev.get("services", {}).items():
            if svc not in all_services:
                all_services[svc] = {"count": 0, "devices": []}
            all_services[svc]["count"] += cnt
            name = get_device_name(dev)
            icon = get_device_icon(dev)
            all_services[svc]["devices"].append(f"{icon} {name}")

    if not all_services:
        print(warn("No services detected yet"))
        return

    print(color(BOLD, f"  {'SERVICE':15s}  {'COUNT':>6s}  DEVICES"))
    print(color(D, "  " + "─" * 60))
    for svc, info in sorted(all_services.items(), key=lambda x: -x[1]["count"]):
        devs_str = ", ".join(info["devices"][:3])
        if len(info["devices"]) > 3:
            devs_str += f" +{len(info['devices'])-3}"
        c = G if info["count"] > 100 else Y if info["count"] > 10 else D
        print(f"  {svc:15s}  {color(c, str(info['count'])):>6s}  {devs_str}")
    print()

def cmd_urls(args):
    """Show recent URLs captured."""
    mini_banner()
    state = load_state()
    if not state:
        print(warn("No state data"))
        return

    # Collect all URLs from events
    urls = []
    for e in state.get("events", []):
        if e.get("kind") == "http":
            urls.append(e)

    if not urls:
        print(warn("No HTTP URLs captured yet (HTTPS URLs are encrypted)"))
        print(info("HTTP URLs appear when devices use unencrypted connections"))
        return

    print(color(BOLD, f"  {'TIME':10s}  {'DEVICE':16s}  URL"))
    print(color(D, "  " + "─" * 80))
    for e in urls[-20:]:
        t = time.strftime("%H:%M:%S", time.localtime(e.get("t", 0)))
        dev = e.get("dev", "?")
        host = e.get("host", "")
        print(f"  {color(D, t):10s}  {dev:16s}  {color(C, host)}")
    print()

def cmd_domains(args):
    """Top domains."""
    mini_banner()
    state = load_state()
    if not state:
        print(warn("No state data"))
        return

    domains = state.get("domains", {})
    if not domains:
        print(warn("No domains captured yet"))
        return

    real = {k: v for k, v in domains.items()
            if not k.endswith(".local") and not k.endswith(".in-addr.arpa") and not k.startswith("lb.")}
    sorted_d = sorted(real.items(), key=lambda x: -x[1].get("count", 0))[:25]

    print(color(BOLD, f"  {'COUNT':>6}  {'DOMAIN':45s}  {'TYPE':8s}  DEVICES"))
    print(color(D, "  " + "─" * 95))
    for dom, info in sorted_d:
        cnt = info.get("count", 0)
        kinds = " ".join(info.get("kinds", {}).keys())
        devs = list(info.get("devs", {}).keys())
        dev_str = ", ".join(devs[:2])
        if len(devs) > 2: dev_str += f" +{len(devs)-2}"
        c = G if cnt > 100 else Y if cnt > 10 else D
        svc = info.get("service", "")
        svc_str = f"{svc}" if svc else kinds
        print(f"  {color(c, str(cnt)):>6}  {dom[:45]:45s}  {svc_str:8s}  {dev_str}")
    print()

def cmd_scan(args):
    """Quick ARP scan."""
    mini_banner()
    print(info(f"Scanning subnet on en0..."))
    sys.path.insert(0, str(ROOT))
    try:
        import scapy.all as scapy
        from scapy.layers.l2 import srp, Ether, ARP
        from device_detect import detect_device
        from oui_db import lookup_vendor
        iface = "en0"
        r = subprocess.run(["ifconfig", iface], capture_output=True, text=True)
        my_ip = "192.168.2.42"
        for line in r.stdout.splitlines():
            if "inet " in line:
                my_ip = line.split("inet ")[1].split()[0]
                break
        subnet = ".".join(my_ip.split(".")[:3])
        ans, _ = srp(Ether(dst="ff:ff:ff:ff:ff:ff")/ARP(pdst=f"{subnet}.0/24"),
                      timeout=3, verbose=0, iface=iface)
        # Also get ARP hostnames
        arp_out = subprocess.run(["arp", "-a", "-i", iface], capture_output=True, text=True)
        hostnames = {}
        for line in arp_out.stdout.splitlines():
            parts = line.split()
            for i, p in enumerate(parts):
                if p == "at" and i > 0 and i + 1 < len(parts):
                    ip = parts[i-1].strip("()")
                    hn = parts[0] if i > 1 else ""
                    if hn not in ("?", ""):
                        hostnames[ip] = hn

        print()
        print(color(BOLD, f"  {'IP':16s}  {'MAC':18s}  {'':2s} {'DEVICE':25s}  {'VENDOR':15s}"))
        print(color(D, "  " + "─" * 85))
        for _, rcv in ans:
            ip = rcv[ARP].psrc
            mac = rcv[Ether].src
            vendor = lookup_vendor(mac)
            hn = hostnames.get(ip, "")
            info = detect_device(hn, vendor)
            print(f"  {ip:16s}  {mac:18s}  {info['icon']} {info['model']:25s}  {vendor:15s}")
    except ImportError:
        print(err("scapy not installed: pip3 install scapy"))
    except Exception as e:
        print(err(f"Scan failed: {e}"))

def cmd_tail(args):
    """Tail live events."""
    mini_banner()
    print(info("Tailing live events (Ctrl+C to stop)...\n"))
    seen = set()
    try:
        while True:
            state = load_state()
            if state:
                events = state.get("events", [])
                for e in events:
                    key = (e.get("t"), e.get("dev"), e.get("host"))
                    if key not in seen:
                        seen.add(key)
                        t = time.strftime("%H:%M:%S", time.localtime(e.get("t", 0)))
                        kind = e.get("kind", "?")
                        kind_color = {"tls": G, "dns": C, "mdns": M, "http": Y}.get(kind, D)
                        dev = e.get("dev", "?")
                        host = e.get("host", "")
                        svc = e.get("service", "")
                        svc_str = f" [{svc}]" if svc else ""
                        print(f"  {color(D, t)}  {color(kind_color, kind.upper()):8s}  {dev:16s}  {color(B, host)}{color(D, svc_str)}")
            time.sleep(1)
    except KeyboardInterrupt:
        print()
        print(info("Stopped"))

def cmd_live(args):
    """Live terminal dashboard with device names, icons, and real-time stats."""
    devs = load_devices()
    device_map = {}
    if devs and devs.get("devices"):
        for ip, dev in devs["devices"].items():
            device_map[ip] = dev

    seen = set()
    event_count = 0
    last_update = 0

    # Clear screen
    sys.stdout.write("\033[2J\033[H")
    sys.stdout.flush()

    try:
        while True:
            state = load_state()
            now = time.time()

            # Rebuild device map periodically
            if now - last_update > 10:
                devs = load_devices()
                if devs and devs.get("devices"):
                    device_map = {}
                    for ip, dev in devs["devices"].items():
                        device_map[ip] = dev
                last_update = now

            # Move cursor to top
            sys.stdout.write("\033[H")
            sys.stdout.flush()

            # Header
            print(color(C + BOLD, "  netwatch live") + color(D, " — real-time network monitor"))
            print(color(D, "  " + "─" * 70))

            if state:
                age = now - state.get("updated", 0)
                fresh = color(G, "LIVE") if age < 5 else color(Y, f"{age:.0f}s stale") if age < 30 else color(R, "OFFLINE")
                packets = state.get("packets", 0)
                domains = len(state.get("domains", {}))
                devices = len(state.get("devices", {}))

                print(f"  Status: {fresh}  │  Packets: {color(C, str(packets))}  │  Domains: {color(C, str(domains))}  │  Devices: {color(C, str(devices))}")
            else:
                print(f"  Status: {color(R, 'NO DATA')}  │  Start with: {color(C, 'netwatch start')}")
            print(color(D, "  " + "─" * 70))

            # New events since last check
            new_events = []
            if state:
                for e in state.get("events", []):
                    key = (e.get("t"), e.get("dev"), e.get("host"))
                    if key not in seen:
                        seen.add(key)
                        new_events.append(e)
                        event_count += 1

            # Stats bar
            if state:
                events = state.get("events", [])
                # Count by kind
                kind_counts = {}
                for e in events:
                    k = e.get("kind", "?")
                    kind_counts[k] = kind_counts.get(k, 0) + 1
                stats_parts = []
                for k in ["tls", "dns", "http", "mdns"]:
                    if k in kind_counts:
                        kind_color = {"tls": G, "dns": C, "mdns": M, "http": Y}.get(k, D)
                        stats_parts.append(f"{color(kind_color, k.upper())}: {kind_counts[k]}")
                # Active devices
                active_devs = set()
                for e in events[-100:]:
                    active_devs.add(e.get("dev", ""))
                stats_parts.append(f"Active: {color(C, str(len(active_devs)))}")
                print(f"  {'  │  '.join(stats_parts)}")
            print(color(D, "  " + "─" * 70))

            # Recent events (last 20)
            print(color(BOLD, f"  {'TIME':10s}  {'TYPE':8s}  {'DEVICE':25s}  {'HOST/SERVICE'}"))
            print(color(D, "  " + "─" * 70))

            if state:
                events = state.get("events", [])
                display = events[-20:] if len(events) > 20 else events
                for e in reversed(display):
                    t = time.strftime("%H:%M:%S", time.localtime(e.get("t", 0)))
                    kind = e.get("kind", "?")
                    kind_color = {"tls": G, "dns": C, "mdns": M, "http": Y}.get(kind, D)
                    dev_ip = e.get("dev", "?")
                    host = e.get("host", "")
                    svc = e.get("service", "")

                    # Get device name
                    dev_info = device_map.get(dev_ip, {})
                    icon = get_device_icon(dev_info)
                    name = get_device_name(dev_info) if dev_info else ""
                    dev_str = f"{icon} {name}" if name else dev_ip
                    if name and dev_ip != name:
                        dev_str += color(D, f" {dev_ip}")

                    # Format host with service
                    host_str = color(B, host[:40])
                    if svc:
                        host_str += color(D, f" [{svc}]")

                    # Highlight new events
                    is_new = (e.get("t"), e.get("dev"), e.get("host")) in {(ne.get("t"), ne.get("dev"), ne.get("host")) for ne in new_events[-5:]}
                    marker = color(G, "▸ ") if is_new else "  "

                    print(f"{marker}{color(D, t):10s}  {color(kind_color, kind.upper()):8s}  {dev_str:25s}  {host_str}")

            # Fill remaining lines
            for _ in range(max(0, 20 - len(display if state else []))):
                print()

            # Footer
            print(color(D, "  " + "─" * 70))
            print(color(D, f"  Events: {event_count} new  │  Ctrl+C to exit  │  Refresh: 1s"))

            time.sleep(1)

    except KeyboardInterrupt:
        print()
        print(info("Stopped"))

